# Copie este archivo a backend/.env (no se versiona). Spring lo lee al arrancar.

# Clave para firmar los JWT: 64+ caracteres aleatorios. Genérela con:
#   openssl rand -base64 48
# Cada ambiente (desarrollo, pruebas, producción) usa una distinta. Si cambia, todas las sesiones se cierran.
JWT_SECRETO=NQMVKPnymElwPHgKVR+Vk6CfQ3KveGm/Dg+QWcIt+5Io1I8db02oujD2YZuK2Gei

DATABASE_URL=jdbc:postgresql://localhost:5432/surco
DATABASE_USER=surco
DATABASE_PASSWORD=surco

# Orígenes del frontend que pueden llamar a la API directamente (separados por coma)
CORS_ORIGENES=http://localhost:3000

# Clave de la Weather API de Google (Google Cloud, con la Weather API habilitada). La usa
# GET /api/v1/weather/current; sin ella, las tarjetas de temperatura, lluvia, humedad y viento salen sin dato.
GOOGLE_WEATHER_API_KEY=